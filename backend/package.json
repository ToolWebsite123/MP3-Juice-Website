{
  "name": "youtube-downloader-backend",
  "version": "2.0.0",
  "description": "High-performance YouTube downloader API with local storage, Redis queue, and auto-cleanup (NO CLOUDINARY)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "worker": "cross-env NODE_ENV=development node src/workers/videoWorker.js",
    "cleanup": "node -e \"import('./src/services/cleanupService.js').then(m => m.default.cleanupOldFiles())\"",
    "storage-check": "node -e \"import('./src/services/cleanupService.js').then(m => m.default.checkStorageUsage())\"",
    "pm2:start": "pm2 start src/server.js --name yt-downloader-api",
    "pm2:worker": "pm2 start src/workers/videoWorker.js --name yt-downloader-worker",
    "pm2:stop": "pm2 stop yt-downloader-api yt-downloader-worker",
    "pm2:restart": "pm2 restart yt-downloader-api yt-downloader-worker",
    "pm2:logs": "pm2 logs",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles --forceExit",
    "test:manual": "node tests/run-tests.js",
    "test:download": "cross-env NODE_ENV=test jest tests/download.test.js --detectOpenHandles --forceExit",
    "test:worker": "cross-env NODE_ENV=test jest tests/worker.test.js --detectOpenHandles --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration.test.js --detectOpenHandles --forceExit",
    "health": "curl http://localhost:5000/health"
  },
  "keywords": [
    "youtube",
    "downloader",
    "yt-dlp",
    "mp3",
    "mp4",
    "express",
    "nodejs",
    "api",
    "mongoose",
    "redis",
    "bull",
    "ffmpeg",
    "video",
    "converter",
    "local-storage"
  ],
  "author": "Code With Zahida",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/youtube-downloader"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "redis": "^4.6.11",
    "winston": "^3.11.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "semi": [
        "error",
        "always"
      ]
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "config": {
    "env": ".env"
  }
}
