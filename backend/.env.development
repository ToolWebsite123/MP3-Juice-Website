# Development environment
NODE_ENV=development
PORT=5000
# You can use local Mongo for dev or Atlas; change as needed
MONGO_URI=mongodb://127.0.0.1:27017/tool-website-dev

# Auth
JWT_SECRET=dev_jwt_secret_please_change
JWT_EXPIRES_IN=7d

# Frontend (local)
CLIENT_URL=http://localhost:5173

# Logging & limits
LOG_LEVEL=debug
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=60

# Storage/processing
DOWNLOAD_PATH=./downloads
MAX_CONCURRENT_DOWNLOADS=3
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
