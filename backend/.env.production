# 🌐 Environment Setup
NODE_ENV=production
PORT=8080

# 🗄️ MongoDB Atlas (Production DB)
MONGO_URI=mongodb+srv://<PROD_DB_USER>:<PROD_DB_PASS>@cluster0.bj0wlui.mongodb.net/tool-website?retryWrites=true&w=majority

# 🔐 Security Settings
# Always use a long, random secret — for example generated via `openssl rand -hex 32`
JWT_SECRET=replace_with_a_strong_random_string
JWT_EXPIRES_IN=30d

# 🌍 Frontend URL (your deployed domain)
CLIENT_URL=https://your-production-domain.com

# 🧠 Redis Queue (Production)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 🧾 Logging & Rate Limiting
LOG_LEVEL=info
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=100

# 💾 File Storage / Processing Paths
# /tmp is best for temporary storage in cloud servers like Render, Vercel, or Docker
DOWNLOAD_PATH=/tmp/downloads

# ⚙️ Processing Limits
MAX_CONCURRENT_DOWNLOADS=10

# 🧩 Binary Paths (system binaries or docker paths)
YTDLP_PATH=/usr/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg

# 🧭 Server URL (optional, useful for queue result URLs)
SERVER_URL=https://your-production-domain.com
