# ═══════════════════════════════════════════════════════════════════════
# ⚙️ MP3JUICE BACKEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Allowed Origins for CORS (Comma-separated for production)
# Example: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGIN=*

# Backend Base URL (Used for absolute download links if needed)
BACKEND_URL=http://localhost:5000

# Rate Limiting
RATE_WINDOW_MS=60000
RATE_MAX=1000

# Cache Configuration (Optional Redis)
# REDIS_URL=redis://localhost:6379

# Cookie Rotation (Optional - disabled by default)
ENABLE_COOKIES=false

# Auto Cleanup Configuration
ENABLE_AUTO_CLEANUP=true

# Optional: Serve Frontend Build from Backend in Production
SERVE_FRONTEND=false