# ============================================
# 🎬 YouTube Downloader - Backend Configuration
# ============================================

# ---- SERVER CONFIGURATION ----
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# ---- FRONTEND CONFIGURATION (CRITICAL!) ----
# ✅ MUST MATCH YOUR FRONTEND PORT
FRONTEND_URL=http://localhost:5173

# Multiple origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- DATABASE CONFIGURATION ----
MONGO_URI=mongodb://localhost:27017/youtube-downloader

# MongoDB Atlas Example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# ---- REDIS CONFIGURATION ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- WORKER SETTINGS ----
WORKER_CONCURRENCY=2

# ---- STORAGE CONFIGURATION ----
# Local storage directory
DOWNLOAD_DIR=./downloads
DOWNLOAD_PATH=./downloads

# File cleanup settings (in hours/minutes)
MAX_FILE_AGE_HOURS=1
CLEANUP_INTERVAL_MINUTES=30
MAX_STORAGE_GB=10
WARNING_THRESHOLD_GB=8

# ---- DOWNLOAD SETTINGS ----
DEFAULT_FORMAT=mp4
DEFAULT_QUALITY=720
MAX_CONCURRENT_DOWNLOADS=5
DOWNLOAD_TIMEOUT_SECONDS=600
PROGRESS_UPDATE_MS=2000

# ---- AUTO CLEANUP ----
ENABLE_AUTO_CLEANUP=true
EMERGENCY_CLEANUP_ENABLED=true

# ---- AUTHENTICATION ----
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_abc123xyz789
JWT_EXPIRE=7d

# ---- RATE LIMITING ----
RATE_WINDOW_MS=60000
RATE_MAX=100

# ---- SSE CONFIGURATION ----
SSE_MAX_CLIENTS=100

# ---- LOGGING ----
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m
LOG_DIR=./logs

# ---- PATHS ----
TEMP_DIR=./temp
COOKIES_PATH=./cookies.txt

# ---- FEATURES ----
ENABLE_BULK_DOWNLOAD=false
ENABLE_DOWNLOAD_HISTORY=false

# ============================================
# 📝 QUICK SETUP INSTRUCTIONS:
# ============================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env and update:
#    - FRONTEND_URL (match your frontend port)
#    - MONGO_URI (your MongoDB connection)
#    - JWT_SECRET (generate new: openssl rand -base64 32)
#
# 3. Install dependencies:
#    npm install
#
# 4. Create required folders:
#    mkdir -p downloads logs temp
#
# 5. Start server:
#    npm run dev
#
# 6. Test health:
#    curl http://localhost:5000/health
#
# ============================================
# ⚠️ PRODUCTION CHECKLIST:
# ============================================
# [ ] Change NODE_ENV to 'production'
# [ ] Update SERVER_URL to your domain
# [ ] Update FRONTEND_URL to production domain
# [ ] Generate strong JWT_SECRET
# [ ] Configure MongoDB Atlas connection
# [ ] Set up Redis (if using cloud)
# [ ] Adjust RATE_MAX for production traffic
# [ ] Enable HTTPS
# [ ] Configure proper CORS origins
# [ ] Set up file cleanup schedule
# [ ] Configure logging properly
# ============================================